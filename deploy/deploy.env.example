# /etc/hetzner/deploy.env
#
# Variables de entorno para deploy-watcher.sh.
# Mismo HCLOUD_TOKEN que está guardado en GitHub como secret.

# Hetzner Cloud API token (formato hc_xxxxxxxxxxxxx).
# El mismo que usa la GitHub Action para escribir el label
# `deploy-sha` en este server.
HCLOUD_TOKEN=__HCLOUD_TOKEN__

# Donde está clonado el repo en el server.
APP_DIR=/opt/app/pos-frontend

# Rama a la que apuntar (debe matchear la rama que dispara el workflow).
BRANCH=Staging

# Path al docker-compose de staging. Si no existe (porque el build
# es externo o no usás compose), el watcher hace solo el git pull
# y avisa con un warning.
COMPOSE_FILE=/opt/app/pos-frontend/docker-compose.staging.yml

# Archivo donde persiste el último sha desplegado. Se crea solo
# en el primer deploy exitoso.
LAST_SHA_FILE=/var/lib/deploy/last-sha
