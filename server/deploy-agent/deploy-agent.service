[Unit]
Description=npos deploy agent (Hetzner label poller)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/npos/deploy-agent.env
ExecStart=/usr/bin/python3 /opt/npos/deploy-agent.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/npos
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
